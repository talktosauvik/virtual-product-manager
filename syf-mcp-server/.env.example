# ============================================================================
# Synchrony Enterprise SDLC & Workspace MCP Server — Environment Template
# Copy this file to `.env` and populate with your environment values.
# ============================================================================

GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_PROJECT_NUMBER=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_CLOUD_REGION=us-central1

MODEL=gemini-3-flash-preview
SPECIALIST_MODEL=gemini-3.5-flash-lite

# Lab 3: GCP Agent Identity & Auth Manager Provider URIs
# Format: projects/<PROJECT_NUMBER>/locations/<REGION>/authProviders/<PROVIDER_ID>
AUTH_PROVIDER_URI=
SYF_MCP_AUTH_PROVIDER_URI=
ATLASSIAN_AUTH_PROVIDER_URI=
BITBUCKET_AUTH_PROVIDER_URI=
ATLASSIAN_AUTH_PROVIDER_ID=atlassian-cloud-auth-provider
BITBUCKET_AUTH_PROVIDER_ID=bitbucket-cloud-auth-provider
SYF_MCP_AUTH_PROVIDER_ID=syf-mcp-auth-provider

# Shared GCS Workspace & Public Base URL
SYF_WORKSPACE_BUCKET=
SYF_PUBLIC_BASE_URL=

# Enterprise SDLC Non-Secret Identifiers
ATLASSIAN_DOMAIN=
ATLASSIAN_EMAIL=
CONFLUENCE_SPACE_KEY=
JIRA_PROJECT_KEY=
JIRA_EPIC_KEY=
BITBUCKET_WORKSPACE=
BITBUCKET_REPO_SLUG=
