# ============================================================================
# Marcus (Architecture & CISO Specialist Agent) — Environment Template
# Copy this file to `.env` and populate with your environment values.
# ============================================================================

GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_PROJECT_NUMBER=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_CLOUD_REGION=us-central1

MODEL=gemini-3-flash-preview
SPECIALIST_MODEL=gemini-3.5-flash-lite
THINKING_LEVEL=low

# Format: projects/<PROJECT_NUMBER>/locations/<REGION>/authProviders/<PROVIDER_ID>
AUTH_PROVIDER_NAME=
AUTH_PROVIDER_URI=
SYF_MCP_AUTH_PROVIDER_URI=
AGENT_ENGINE_ID=
SYF_MCP_URL=
SYF_WORKSPACE_BUCKET=
