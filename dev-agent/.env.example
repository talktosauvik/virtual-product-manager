GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_PROJECT_NUMBER=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_CLOUD_AGENT_ENGINE_LOCATION=us-central1
GOOGLE_CLOUD_AGENT_ENGINE_ID=
AGENT_ENGINE_ID=

MODEL=gemini-3-flash-preview
THINKING_LEVEL=low

# Format: projects/<PROJECT_NUMBER>/locations/<REGION>/authProviders/<PROVIDER_ID>
AUTH_PROVIDER_NAME=
AUTH_PROVIDER_URI=
SYF_MCP_AUTH_PROVIDER_URI=
SYF_AUTH_USER_ID=syf-vpm-runtime

SYF_MCP_URL=
SYF_MCP_SERVER_PUBLIC_URL=
LIVE_GATEWAY_URL=
SYF_WORKSPACE_BUCKET=
WORKSPACE_BUCKET=
ATLASSIAN_DOMAIN=
BITBUCKET_WORKSPACE=
BITBUCKET_REPO_SLUG=
JIRA_PROJECT_KEY=
JIRA_EPIC_KEY=
JIRA_DEFAULT_STORY_ID=
DEFAULT_BRANCH_NAME=
LANGFUSE_INTERNAL_URL=
JWKS_CACHE_TTL_SECONDS=300
