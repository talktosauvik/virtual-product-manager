FROM registry.access.redhat.com/ubi9/python-312:latest
LABEL maintainer="SYF-Platform-Mesh-Squad <ai-platform@syf.bank>"
LABEL com.synchrony.compliance="pci-dss-v4.0-hipaa-tier1"
LABEL mesh.syf.bank/injected="true"

WORKDIR /opt/app-root/src
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY otel_dlp_proxy.py .
USER 1001
EXPOSE 8080
CMD ["uvicorn", "otel_dlp_proxy:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "4"]
