# ============================================================================
# Synchrony Financial (SYF) Virtual Product Manager — Environment Template
# Copy this file to `.env` and populate with your environment values.
# NEVER commit `.env` or raw secrets/PATs to Git — store tokens in GCP Auth Manager.
# ============================================================================

# Google Cloud & Vertex AI Configuration
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_PROJECT_NUMBER=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_CLOUD_AGENT_ENGINE_LOCATION=us-central1

# Gemini Model Configuration
MODEL=gemini-3-flash-preview
SPECIALIST_MODEL=gemini-3.5-flash-lite
THINKING_LEVEL=low

# Lab 2: Vertex AI Memory Bank Configuration
MEMORY_BANK_ID=
MEMORY_BANK_LOCATION=us-central1

# Lab 3: GCP Agent Identity & Auth Manager Provider URIs
# Format: projects/<PROJECT_NUMBER>/locations/<REGION>/authProviders/<PROVIDER_ID>
AUTH_PROVIDER_URI=
SYF_MCP_AUTH_PROVIDER_URI=
ATLASSIAN_AUTH_PROVIDER_URI=
BITBUCKET_AUTH_PROVIDER_URI=
ATLASSIAN_AUTH_PROVIDER_ID=atlassian-cloud-auth-provider
BITBUCKET_AUTH_PROVIDER_ID=bitbucket-cloud-auth-provider
SYF_MCP_AUTH_PROVIDER_ID=syf-mcp-auth-provider

# Shared GCS Workspace
SYF_WORKSPACE_BUCKET=

# Cloud Run & Agent Engine Endpoints
SYF_PUBLIC_BASE_URL=
SYF_MCP_URL=
SYF_MCP_SERVER_URL=
LIVE_GATEWAY_URL=
FINOPS_AGENT_URL=
FINOPS_AGENT_ENGINE_ID=
ARCH_AGENT_URL=
DEV_AGENT_URL=

# Enterprise SDLC Non-Secret Identifiers (Confluence, Jira, Bitbucket)
ATLASSIAN_DOMAIN=
ATLASSIAN_EMAIL=
CONFLUENCE_SPACE_KEY=
CONFLUENCE_PRD_PAGE_ID=
CONFLUENCE_PRD_PAGE_SLUG=
CONFLUENCE_ADR_PAGE_ID=
CONFLUENCE_ADR_PAGE_SLUG=
JIRA_PROJECT_KEY=
JIRA_EPIC_KEY=
BITBUCKET_WORKSPACE=
BITBUCKET_REPO_SLUG=
